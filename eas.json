{
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "distribution": "store",
        "image": "macos-sequoia-15.6-xcode-26.0"
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
