{
  "expo": {
    "name": "Logos AI",
    "slug": "logos-ai",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/app-icon.icon/Assets/icon.png",
    "scheme": "logosai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.logosai.app",
      "icon": "./assets/app-icon.icon",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.logosai.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF6EE",
        "foregroundImage": "./assets/android-icon.png",
        "monochromeImage": "./assets/android-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "pt-BR",
              "en"
            ],
            "android": [
              "pt-BR",
              "en"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF6EE",
          "dark": {
            "backgroundColor": "#13110D"
          }
        }
      ],
      "react-native-bottom-tabs",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1C2D4A"
        }
      ],
      [
        "@bittingz/expo-widgets",
        {
          "ios": {
            "src": "./widgets/ios",
            "deploymentTarget": "16.4",
            "devTeamId": "\"\"",
            "mode": "production",
            "moduleDependencies": [],
            "useLiveActivities": false,
            "frequentUpdates": false,
            "xcode": {
              "widgetBundleIdentifier": "com.logosai.app.DailyVerseWidget",
              "appGroupId": "group.com.logosai.app.expowidgets",
              "configOverrides": {
                "ASSETCATALOG_COMPILER_APPICON_NAME": "\"\""
              },
              "appExtAPI": false
            }
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "app-logos",
          "organization": "hcstack",
          "useNativeInit": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "isTestFlight": false,
      "eas": {
        "projectId": "3ab8c457-ba28-43bc-a02e-801760483963"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3ab8c457-ba28-43bc-a02e-801760483963"
    }
  }
}
